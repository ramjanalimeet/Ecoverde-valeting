{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecoverde-valeting",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets the worker call itself (used by OpenNext for caching)
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ecoverde-valeting"
    }
  ],
  "d1_databases": [
    {
      // Bookings, blog posts, email log and settings for the /dashboard
      "binding": "DB",
      "database_name": "ecoverde-db",
      "database_id": "d1f32605-47d1-4b22-8de0-389a9d9da888",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Non-secret runtime settings. Secrets (RESEND_API_KEY, DASHBOARD_PASSWORD, SESSION_SECRET): npx wrangler secret put <NAME>
  "vars": {
    "QUOTE_TO_EMAIL": "info@ecoverdevaleting.co.uk",
    "QUOTE_FROM_EMAIL": "Ecoverde Website <quotes@ecoverdevaleting.co.uk>"
  }
  // To serve on your own domain, uncomment and adjust (the zone must be on your Cloudflare account):
  // "routes": [
  //   { "pattern": "ecoverdevaleting.co.uk", "custom_domain": true },
  //   { "pattern": "www.ecoverdevaleting.co.uk", "custom_domain": true }
  // ]
}
