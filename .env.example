# Used by `next dev` / `next build`. For Cloudflare, set these in the Worker settings (see README).

# Quote form email delivery via Resend (https://resend.com) — works on Cloudflare Workers.
# Without a key, /api/quote returns 503 and the form shows call / WhatsApp fallbacks (never a fake success).
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@ecoverdevaleting.co.uk
QUOTE_FROM_EMAIL="Ecoverde Website <quotes@ecoverdevaleting.co.uk>"

# Build-time (NEXT_PUBLIC_*) — must be set where the site is BUILT (Workers Builds → Build variables).
NEXT_PUBLIC_SITE_URL=https://ecoverdevaleting.co.uk
NEXT_PUBLIC_REVIEWS_URL=
NEXT_PUBLIC_TRUSTINDEX_ID=
