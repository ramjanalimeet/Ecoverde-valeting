# Quote form email delivery (SMTP). Without these, /api/quote returns 503
# and the form shows an error with call / WhatsApp fallbacks — it never fakes success.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Where quote requests are delivered, and the From address used to send them
QUOTE_TO_EMAIL=info@ecoverdevaleting.co.uk
QUOTE_FROM_EMAIL="Ecoverde Website <no-reply@ecoverdevaleting.co.uk>"

# Public site URL (canonical links, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ecoverdevaleting.co.uk
# Optional: verified Trustindex reviews page. The "Read all our reviews" button is hidden until set.
NEXT_PUBLIC_REVIEWS_URL=
# Optional: Trustindex widget ID — shows the live Trustindex review carousel under "All 560+ reviews".
NEXT_PUBLIC_TRUSTINDEX_ID=
